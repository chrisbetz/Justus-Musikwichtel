{:deps     {:aliases [:cljs]}
 :nrepl    {:port 7002}
 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   :modules    {:main {:init-fn musikwichtel.core/init!}}
   :devtools   {:after-load musikwichtel.core/after-load!
                :http-root  "resources/public"
                :http-port  8280}}}}

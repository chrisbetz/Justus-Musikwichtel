{:paths ["src/clj" "src/cljc" "resources"]
 :nextjournal/garden {:exec-fn musikwichtel.main}
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}

  ;; HTTP server and Ring
  ring/ring-core           {:mvn/version "1.13.0"}
  ring/ring-jetty-adapter  {:mvn/version "1.13.0"}
  ring/ring-defaults       {:mvn/version "0.5.0"}
  ring/ring-json           {:mvn/version "0.5.1"}
  compojure/compojure      {:mvn/version "1.7.1"}

  ;; JSON and Config
  cheshire/cheshire        {:mvn/version "5.13.0"}
  aero/aero                {:mvn/version "1.1.6"}

  ;; Datalevin (Application Garden persistent storage & embedded Datalog)
  datalevin/datalevin      {:mvn/version "0.9.22"}

  ;; SQLite backend for local dev
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.981"}
  org.xerial/sqlite-jdbc            {:mvn/version "3.47.1.0"}

  ;; Application.garden authentication (Garden ID)
  io.github.nextjournal/garden-id
  {:git/url "https://github.com/nextjournal/garden-id.git"
   :git/sha "7d19e5400b9ac9082e444f2c0e96d9b5e616a483"}

  ;; GorillaLabs Bauhaus modules
  org.gorillalabs.bauhaus/setup-logging
  {:git/url  "https://github.com/gorillalabs/bauhaus.git"
   :git/sha  "f76536429fdb1ba8da1a8ed8521d2a6301cb1164"
   :deps/root "modules/setup/logging"}

  org.gorillalabs.bauhaus/setup-shutdown
  {:git/url  "https://github.com/gorillalabs/bauhaus.git"
   :git/sha  "f76536429fdb1ba8da1a8ed8521d2a6301cb1164"
   :deps/root "modules/setup/shutdown"}}

 :aliases
 {:cljs
  {:extra-paths ["src/cljs"]
   :extra-deps  {thheller/shadow-cljs      {:mvn/version "2.28.21"}
                 org.clojure/clojurescript {:mvn/version "1.11.132"}
                 reagent/reagent           {:mvn/version "1.2.0"}
                 re-frame/re-frame         {:mvn/version "1.4.3"}}}

  :dev
  {:extra-paths ["dev"]
   :extra-deps  {nrepl/nrepl {:mvn/version "1.3.1"}}}

  :run
  {:main-opts ["-m" "musikwichtel.main"]
   :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
               "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}}}
